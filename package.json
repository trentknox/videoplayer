{
  "name": "vivid-media-player",
  "private": true,
  "version": "0.1.0",
  "description": "A local-first, multi-provider media library and virtual channel player.",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "preview": "vite preview",
    "desktop": "npm run build && electron .",
    "make:win": "npm run build && electron-builder --win nsis",
    "deploy:pages": "npm run build && wrangler pages deploy web-dist --project-name=vivid-media-player"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "hls.js": "^1.6.13",
    "js-yaml": "^4.3.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^37.4.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "wrangler": "^4.41.0"
  },
  "build": {
    "appId": "com.cybercitymedia.vivid",
    "productName": "Vivid Media Player",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "trentknox",
      "repo": "videoplayer"
    },
    "files": [
      "web-dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
